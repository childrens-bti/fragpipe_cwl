# Editor and system files
.DS_Store
*.swp
*.bak
*.log
*.tmp
-*

# Python cache (if any helper scripts are used)
__pycache__/
*.py[cod]

# CWL job and temp files
*.cwl.json
*.inputs.json
*.outputs.json
!prep.sh
*.err
*.out
tmp/

# Output and result files
*.bam
*.bai
*.vcf
*.gz
*.zip
outputs/*
params/*
!outputs/.gitkeep
!params/.gitkeep
test/
logs/*
!logs/.gitkeep
sbg-hints/* 
!sbg-hints/.gitkeep
!workflows/.gitkeep
!tools/.gitkeep
!scripts/.gitkeep
# harmonized data
data/*
!data/.gitkeep
!data/manifest_files/
!data/manifest_files/**
!data/workflow_files/
!data/workflow_files/**
!data/references/
# manifest files
manifests/*
!manifests/.gitkeep

# ignore fragpipe tools (only for initial docker build)
tools/*.jar

# Ignore root shell scripts
run_fragpipe.sh
run_data.sh

# ignore cwl local run temp files
.cwl-tmp/
.cwl-out/
logs/
# sbfs mount temp files
.sbfs-home/
.sbfs-log/

docs/*